<#
    Module manifest for <%= $PLASTER_PARAM_ModuleName %>

    Generated by the BsnModule Plaster template on <%= $PLASTER_Date %>.
    NOTE: Avoid single quotes in parameter values - they are interpolated
    verbatim into this manifest.
#>
@{
    RootModule = '<%= $PLASTER_PARAM_ModuleName %>.psm1'
    ModuleVersion = '<%= $PLASTER_PARAM_Version %>'
    GUID = '<%= $PLASTER_Guid1 %>'
    Author = '<%= $PLASTER_PARAM_Author %>'
    CompanyName = 'BSVN'
    Copyright = '(c) <%= $PLASTER_Year %> BSVN. All rights reserved.'
    Description = '<%= $PLASTER_PARAM_Description %>'
    PowerShellVersion = '5.1'
    CompatiblePSEditions = @('Desktop', 'Core')
    FunctionsToExport = @('<%= $PLASTER_PARAM_CmdletName %>')
    CmdletsToExport = @()
    VariablesToExport = @()
    AliasesToExport = @()
    DscResourcesToExport = @()
    PrivateData = @{
        PSData = @{
            Tags = @('BSVN', 'Lmt')
            LicenseUri = 'https://github.com/BSVN/Lmt.Commons/blob/main/LICENSE'
            ProjectUri = 'https://github.com/BSVN/Lmt.Commons'
            ReleaseNotes = '<%= $PLASTER_PARAM_ModuleName %> <%= $PLASTER_PARAM_Version %> initial release.'
        }
    }
}
