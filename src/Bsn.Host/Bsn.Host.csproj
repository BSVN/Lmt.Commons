<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Bsn.Host</AssemblyName>
    <RootNamespace>Bsn.Host</RootNamespace>
    <Description>ConPTY terminal recording engine for the Bsn.Host PowerShell module.</Description>
    <OutputPath>lib\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test sources under tests/ (Pester .ps1 and the NUnit C# project) must
         not be compiled into the shipped interop assembly. -->
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

</Project>
